import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.cluster import KMeans
from sklearn.mixture import GaussianMixture
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score

# Load dataset
data_path = '/content/sample_data/Mall_Customers.csv'
df = pd.read_csv(data_path)

# Display first few rows
print(df.head())

# Preprocessing: Selecting numerical features only
features = df.select_dtypes(include=[np.number]).columns.tolist()
X = df[features]
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Running K-Means and Gaussian Mixture Model (GMM) side by side
print("Comparison of K-Means and GMM Accuracy Scores:")
print(f"{'Run':<5} {'K-Means (%)':<15} {'GMM (%)':<15}")
print("-" * 40)

for i in range(1, 11):
    # K-Means
    kmeans = KMeans(n_clusters=5, init='k-means++', random_state=i)
    clusters_kmeans = kmeans.fit_predict(X_scaled)
    kmeans_score = silhouette_score(X_scaled, clusters_kmeans) * 100
    
    # Gaussian Mixture Model (GMM)
    gmm = GaussianMixture(n_components=5, random_state=i)
    clusters_gmm = gmm.fit_predict(X_scaled)
    gmm_score = silhouette_score(X_scaled, clusters_gmm) * 100
    
    print(f"{i:<5} {kmeans_score:.2f}%{'':<6} {gmm_score:.2f}%")

# Scatter plot for visualization
plt.figure(figsize=(10, 5))
plt.scatter(X_scaled[:, 0], X_scaled[:, 1], c=kmeans.labels_, cmap='viridis', label='K-Means Clusters')
plt.title("K-Means Clustering Visualization")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.legend()
plt.show()

plt.figure(figsize=(10, 5))
plt.scatter(X_scaled[:, 0], X_scaled[:, 1], c=clusters_gmm, cmap='plasma', label='GMM Clusters')
plt.title("Gaussian Mixture Model (GMM) Clustering Visualization")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.legend()
plt.show()





